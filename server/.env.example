PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/teammatch_ai
CLIENT_ORIGIN=http://localhost:5173

# TRUST_PROXY=1

# Select an optional server-side resume AI provider. Never put this value in client configuration.
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL="gemini-3.5-flash-lite"
AI_TEMPERATURE=0
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=1

# Resume upload and extraction limits.
RESUME_MAX_FILE_SIZE_MB=5
RESUME_MAX_PAGES=10
RESUME_MAX_TEXT_CHARS=30000
ONBOARDING_DRAFT_TTL_MINUTES=30
