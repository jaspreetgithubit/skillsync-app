PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/teammatch_ai
CLIENT_ORIGIN=http://localhost:5173

# TRUST_PROXY=1

# Select an optional server-side resume AI provider. Never put this value in client configuration.
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL="gemini-3.5-flash-lite"
AI_TEMPERATURE=0
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=1

# Resume upload and extraction limits.
RESUME_MAX_FILE_SIZE_MB=5
RESUME_MAX_PAGES=10
RESUME_MAX_TEXT_CHARS=30000
ONBOARDING_DRAFT_TTL_MINUTES=30

# Individual student-project compatibility scoring (relative component weights).
COMPATIBILITY_REQUIRED_WEIGHT=70
COMPATIBILITY_PREFERRED_WEIGHT=20
COMPATIBILITY_CLASSIFICATION_THRESHOLD=60

# Team recommendation limits and deterministic scoring.
TEAM_RECOMMENDATION_DEFAULT_TEAM_SIZE=3
TEAM_RECOMMENDATION_MAX_TEAM_SIZE=8
TEAM_RECOMMENDATION_MAX_CANDIDATES=50
TEAM_RECOMMENDATION_MAX_EXACT_COMBINATIONS=25000
TEAM_RECOMMENDATION_BEAM_WIDTH=200
TEAM_RECOMMENDATION_TOP_K=5
TEAM_COMPATIBILITY_SKILLS_WEIGHT=60
TEAM_COMPATIBILITY_ROLES_WEIGHT=15
TEAM_COMPATIBILITY_INDIVIDUAL_WEIGHT=15
TEAM_COMPATIBILITY_COMPLEMENTARITY_WEIGHT=10
TEAM_COMPATIBILITY_HIGH_THRESHOLD=80
TEAM_COMPATIBILITY_MODERATE_THRESHOLD=65
TEAM_COMPATIBILITY_LOW_THRESHOLD=50
