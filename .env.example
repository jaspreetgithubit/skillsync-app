# =============================================================================
# SYNCSKILLS.AI ENVIRONMENT CONFIGURATION EXAMPLE
# =============================================================================

# Gemini key is configured server-side only (see GEMINI_API_KEY at the bottom).
# Get a key at: https://aistudio.google.com/app/apikey

# Supabase Authentication & Database
# (Obtain from your Supabase Project Settings -> API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Optional Backend Configuration
PORT=5000
MONGODB_URI=mongodb://localhost:27017/teammatch_ai


# -----------------------------------------------------------------------------
# Gemini Chatbot BACKEND key (server-side only - never prefix with VITE_)
# Put your real key ONLY in your local .env file, never here.
# -----------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
CHAT_SERVER_PORT=5050
