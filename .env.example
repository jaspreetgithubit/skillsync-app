# =============================================================================
# SYNCSKILLS.AI ENVIRONMENT CONFIGURATION EXAMPLE
# =============================================================================

# Google Gemini Generative AI API Key (Get free key at: https://aistudio.google.com/app/apikey)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Authentication & Database
# (Obtain from your Supabase Project Settings -> API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Optional Backend Configuration
PORT=5000
MONGODB_URI=mongodb://localhost:27017/teammatch_ai

